<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" autoReload="true" throwExceptions="false" internalLogLevel="Off" internalLogFile="NlogRecords.log">
	<!--Nlog内部日志记录为Off关闭。除非纠错，不可以设为Trace否则速度很慢，起码Debug以上-->
	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
		<add assembly="NLog.Extensions.Logging" />
		<add assembly="Seq.Client.NLog"/>
		<add assembly="CorrelationId" />
	</extensions>
	<targets>
		<target xsi:type="File" name="log_file" fileName="${basedir}/App_Data/nlog/${date:format=yyyy-MM}/${level}-${shortdate}.csv" encoding="utf-8">
			<layout xsi:type="CSVLayout">
				<column name="Source" layout="Webapi" />
				<column name="ThreadId" layout="${threadid}" as="number" />
				<column name="MachineName" layout="${machinename}" />
				<column name="Environment" layout="${aspnet-environment}" />
				<column name="Logger" layout="${logger}" />
				<column name="IP" layout="${aspnet-item:variable=IP}" />
				<column name="Url" layout="${aspnet-request-url:IncludeHost=true:IncludePort=true:IncludeQueryString=true:IncludeScheme=true}" />
				<column name="Code" layout="${aspnet-response-statuscode}" />
				<column name="RequestHeaders" layout="${aspnet-request-headers:HeaderNames=Host,Referer,Origin,Authorization}" />
				<column name="RequestQueryString" layout="${aspnet-request-querystring}" />
				<column name="RequestBody" layout="${aspnet-request-posted-body}" />				
				<column name="CorrelationId" layout="${aspnet-TraceIdentifier}" />
				<column name="AssemblyVersion" layout="${assembly-version}" />
				<column name="Action" layout="${aspnet-mvc-action}" />
				<column name="Exception" layout="${exception:format=tostring}" />
				<column name="StackTracer" layout="${stacktrace}" />
				<column name="Custom" layout="${gdc:item=Custom}" />
				<column name="ExtraData" layout="${event-properties:item=ExtraData}" />
			</layout>
		</target>


		<target name="seq" xsi:type="BufferingWrapper" bufferSize="1000" flushTimeout="2000">
			<target xsi:type="Seq" serverUrl="http://localhost:5341/" apiKey="">
				<property name="Source" value="Webapi" />
				<property name="ThreadId" value="${threadid}" as="number" />
				<property name="MachineName" value="${machinename}" />
				<property name="Environment" value="${aspnet-environment}" />
				<property name="Logger" value="${logger}" />
				<property name="IP" value="${aspnet-item:variable=IP}" />
				<property name="Url" value="${aspnet-request-url:IncludeHost=true:IncludePort=true:IncludeQueryString=true:IncludeScheme=true}" />
				<property name="Code" value="${aspnet-response-statuscode}" />
				<property name="RequestHeaders" value="${aspnet-request-headers:HeaderNames=Host,Referer,Origin,Authorization}" />
				<property name="RequestQueryString" value="${aspnet-request-querystring}" />
				<property name="RequestBody" value="${aspnet-request-posted-body}" />				
				<property name="CorrelationId" value="${aspnet-TraceIdentifier}" />
				<property name="AssemblyVersion" value="${assembly-version}" />
				<property name="Action" value="${aspnet-mvc-action}" />
				<property name="Exception" value="${exception:format=tostring}" />
				<property name="StackTracer" value="${stacktrace}" />
				<property name="Custom" value="${gdc:item=Custom}" />
				<property name="ExtraData" value="${event-properties:item=ExtraData}" />
				
				<!--https://blog.elmah.io/nlog-tutorial-the-essential-guide-for-logging-from-csharp/-->
			</target>
		</target>
	</targets>
	<column name="stacktrace" layout="${stacktrace}" />
	<column name="basedir" layout="${basedir}" />
	<column name="processid" layout="${processid}" />
	<column name="exception" layout="${exception:format=tostring}" />
	<rules>
		<!--跳过所有级别的Microsoft组件的日志记录-->
		<logger name="Microsoft.*" minlevel="Trace" final="true" />
		<!--跳过所有级别的CorrelationId组件的Info 層級下的 Log-->
		<logger name="CorrelationId.*" minlevel="Trace" maxlevel="Info" final="true" />
		<!-- BlackHole without writeTo -->
		<!--只通过数据库记录日志，如果给了name名字，cs里用日志记录的时候，取logger需要把name当做参数-->

		<logger name="logfile" writeTo="log_file" />
		<logger name="seq" minlevel="Info" writeTo="seq" />
	</rules>
</nlog>