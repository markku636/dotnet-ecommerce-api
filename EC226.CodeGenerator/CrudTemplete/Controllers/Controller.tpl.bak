        #region 刪除數據============================================================
        // POST: Api/{{ModelClassName}}/DoDelete/10
        /// <summary>
        /// 刪除ByID
        /// </summary>
        /// <param name="entity"></param>
        /// <returns></returns>
        [HttpPost]
        [Description("刪除ByID")]
        public async Task<Result> DoDelete([FromBody]FMIntId entity)
        {
            var result = new Result();

            var model = await _{{ModelClassName}}Services.ExistsAsync(p => p.{{PrimaryKey}} == entity.id, true);
            if (!model)
            {
                result.Fail(GlobalConstVars.DataisNo);
				   return result;
            }
            result = await _{{ModelClassName}}Services.DeleteByIdAsync(entity.id);

            return result;
        }
        #endregion

        #region 批次刪除============================================================
        // POST: Api/{{ModelClassName}}/DoBatchDelete/10,11,20
        /// <summary>
        /// 批次刪除
        /// </summary>
        /// <param name="entity"></param>
        /// <returns></returns>
        [HttpPost]
        [Description("批次刪除")]
        public async Task<Result> DoBatchDelete([FromBody]FMArrayIntIds entity)
        {
            var result = await _{{ModelClassName}}Services.DeleteByIdsAsync(entity.id);
            return result;
        }

