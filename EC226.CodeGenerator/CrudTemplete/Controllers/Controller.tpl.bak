        /// <returns></returns>
        [HttpPost]
        [Description("編輯提交")]
        public async Task<Result> DoEdit([FromBody]{{ModelClassName}} entity)
        {
            var result = await _{{ModelClassName}}Services.UpdateAsync(entity);
            return result;
        }
