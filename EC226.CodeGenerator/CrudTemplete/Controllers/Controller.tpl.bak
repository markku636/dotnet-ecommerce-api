        #region 修改============================================================
        // POST: Api/{{ModelClassName}}/GetEdit
        /// <summary>
        /// 修改
        /// </summary>
        /// <param name="entity"></param>
        /// <returns></returns>
        [HttpPost]
        [Description("修改")]
        public async Task<Result<{{ModelClassName}}>> GetEdit([FromBody]FMIntId entity)
        {
            var result = new Result<{{ModelClassName}}>();

            var model = await _{{ModelClassName}}Services.QueryByIdAsync(entity.id, false);
            if (model == null)
            {
                result.Fail("不存在此資訊");
                return result;
            }
            
            result.Data = model;

            return result;
        }
        #endregion

        #region 編輯提交============================================================
        // POST: Api/{{ModelClassName}}/Edit
        /// <summary>
